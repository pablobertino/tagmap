# Copiar a .env (local) o cargar con `fly secrets set` (nube). Nunca commitear.

# Supabase — usar la clave service_role (solo en el recolector, jamás en la app)
SUPABASE_URL=https://rlaxxavhzrrrmjrkymlm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ruta al secrets.json de GoogleFindMyTools (local)
GFMT_SECRETS_PATH=./secrets.json
# Alternativa para la nube: contenido de secrets.json en base64 (tiene prioridad si está definido)
GFMT_SECRETS_B64=

# Ruta al clon de GoogleFindMyTools
GFMT_REPO_PATH=./vendor/GoogleFindMyTools

# Intervalo entre consultas (mínimo 5)
COLLECT_INTERVAL_MINUTES=15

# Identificador de esta instancia del recolector (para heartbeat)
COLLECTOR_ID=fly-tagmap-1

# Nivel de log
LOG_LEVEL=INFO
